{
  "extends": ["next/core-web-vitals", "next", "eslint:recommended", "prettier"],
  "rules": {
    "semi": ["error", "never"],
    "no-unused-vars": [
      "warn",
      { 
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  },
  "env": {
    "browser": false,
    "node": true,
    "es6": true
  }
}
